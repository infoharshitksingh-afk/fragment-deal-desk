# Required
ACCESS_CODE=choose-a-long-passphrase

# Set automatically when you add Upstash Redis from the Vercel marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: enables the weekday scheduled run in vercel.json
CRON_SECRET=

# Optional: API keys can be set here instead of on the Settings page (env vars take priority)
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
RESEND_API_KEY=
SMTP_PASS=
